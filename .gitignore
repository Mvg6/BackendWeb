# Lista blanca: se ignora todo y solo se versiona lo que se permite abajo.
/*
!/.gitignore
!/README.md
!/main.py
!/requirements.txt
!/requirements-dev.txt
!/.env.example
!/pytest.ini
!/tests/
!/pool_claves.py
!/pool_keys.py
!/pruebas_apis/
/pruebas_apis/*
!/pruebas_apis/carga.py
!/pruebas_apis/prueba_real.py

# Nunca se versionan (ya quedan fuera por la lista blanca; se dejan explícitos).
.env
historial.db
respaldos/
miniaturas/
reporte_pruebas/
.venv/
.idea/
*.onnx
__pycache__/
*.py[cod]
