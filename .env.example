# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env nunca se sube al repositorio: está en .gitignore.

# Clave de la API de Gemini (Google AI Studio). Sin clave, la explicación usa la plantilla.
GEMINI_API_KEY=

# Opcional. Modelo Flash a usar; si está vacío o no está disponible para la clave,
# se elige automáticamente un Flash estable (se registra en el log cuál quedó).
GEMINI_MODEL=

# Opcional. Modelos que nunca se usan, ni como principal ni como alternativa para
# los reintentos (lista separada por comas). Si la línea no está, se excluye
# gemini-3.8-flash (su nivel gratuito es de solo 20 consultas por día). Vacía
# (GEMINI_MODELOS_EXCLUIDOS=) = no se excluye ninguno.
GEMINI_MODELOS_EXCLUIDOS=gemini-3.8-flash

# on/off. Con off no se envía nada a Gemini y se usa la explicación de plantilla.
EXPLICACION_IA=on

# Explicaciones con Gemini por hora y por IP para usuarios SIN sesión (que aceptaron
# el envío de la foto). Al pasarlo se usa la plantilla (motivo "limite_ia"). 0 = ninguna.
LIMITE_IA_SIN_SESION_POR_HORA=3

# on/off. on al mostrar la app por un túnel (cloudflared): desactiva /docs y /redoc
# y restringe CORS al mismo origen. Con on, abrir el frontend con Live Server no funciona.
MODO_PUBLICO=off
