# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env nunca se sube al repositorio: está en .gitignore.

# Clave de la API de Gemini (Google AI Studio). Sin clave, la explicación usa la plantilla.
GEMINI_API_KEY=

# Opcional. Modelo Flash a usar; si está vacío o no está disponible para la clave,
# se elige automáticamente un Flash estable (se registra en el log cuál quedó).
GEMINI_MODEL=

# Opcional. Modelos que nunca se usan, ni como principal ni como alternativa para
# los reintentos (lista separada por comas). Si la línea no está, se excluye
# gemini-3.8-flash (su nivel gratuito es de solo 20 consultas por día). Vacía
# (GEMINI_MODELOS_EXCLUIDOS=) = no se excluye ninguno.
GEMINI_MODELOS_EXCLUIDOS=gemini-3.8-flash

# Opcional. Rotación por modelo en cada clave Gemini del pool, en este orden. El cupo de
# Gemini es por modelo: un 429 (o 500/503/timeout) aparta solo ese modelo de esa clave
# (hasta la medianoche del Pacífico si es el cupo diario) y se prueba el siguiente; la
# clave entera solo se aparta ante 401/403. Si está vacía, se usa GEMINI_MODEL y la
# selección automática de siempre. Los modelos excluidos no se usan aunque estén aquí.
GEMINI_MODELOS_ORDEN=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-26b-a4b-it
# Opcional. Modelos que no aceptan instrucción de sistema ni modo JSON: reciben el prompt
# en el mensaje de usuario y el JSON se valida como texto. Si un modelo responde 400 por
# eso, se detecta solo (hasta reiniciar).
GEMINI_MODELOS_SIN_SISTEMA=

# on/off. Con off no se envía nada a Gemini y se usa la explicación de plantilla.
EXPLICACION_IA=on

# --- Pool de claves de IA (Gemini, Groq, OpenRouter) ---------------------------------
# Las claves se guardan cifradas en historial.db y se administran con pool_keys.py
# (agregar, listar, activar/desactivar, estado). La primera vez que arranca el backend
# con la tabla vacía se importan GEMINI_API_KEY (prioridad 1), GROQ_API_KEY (2) y
# OPENROUTER_API_KEY (3). Ante 429/503/timeout la clave queda en espera y el análisis
# sigue con la siguiente; ante 401/403 se desactiva.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Clave Fernet que cifra el pool. Si falta, el backend la genera y la agrega aquí.
# No la compartas ni la pierdas: sin ella no se pueden descifrar las claves guardadas.
POOL_MASTER_KEY=

# Opcional. Modelo de Groq con imágenes; si está vacío y hay una clave Groq, el backend
# consulta los modelos de Groq, elige uno que acepte imágenes y lo guarda aquí.
GROQ_MODEL=
# Modelo de OpenRouter (con imágenes), obligatorio si se usa una clave de OpenRouter.
OPENROUTER_MODEL=

# --- Modo feria ----------------------------------------------------------------------
# on/off (por defecto off). Con on, el límite sin cuenta (análisis y explicaciones con
# IA por hora por IP) pasa a LIMITE_FERIA_HORA, y cada clave del pool atiende como
# máximo FERIA_IA_RPM llamadas por minuto: lo que exceda pasa a la siguiente clave o,
# si no hay, se devuelve el resultado del modelo sin explicación. Se mantiene la casilla
# de consentimiento para enviar la foto a la IA.
MODO_FERIA=off
LIMITE_FERIA_HORA=300
FERIA_IA_RPM=20

# Explicaciones con Gemini por hora y por IP para usuarios SIN sesión (que aceptaron
# el envío de la foto). Al pasarlo se usa la plantilla (motivo "limite_ia"). 0 = ninguna.
LIMITE_IA_SIN_SESION_POR_HORA=3

# on/off. on al mostrar la app por un túnel (cloudflared): desactiva /docs y /redoc
# y restringe CORS al mismo origen. Con on, abrir el frontend con Live Server no funciona.
MODO_PUBLICO=off
